  "browserslist": [
    "safari >= 16.4",
    "chrome >= 100",
    "edge >= 100"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build --config ui/vite.config.ts",
    "postbuild": "node -e \"require('node:fs').copyFileSync('ui/dist/index.html','office.html')\"",
    "dev": "vite --config ui/vite.config.ts",
    "test": "bun test ui/test",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json",
    "bench": "bun bench/pure.ts",
    "bench:browser": "bun bench/run.ts",
    "bench:sheet": "bun bench/sheet-bench.ts"
  },
